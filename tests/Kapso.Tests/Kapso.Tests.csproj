<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- xUnit v3 test projects are executables. -->
    <OutputType>Exe</OutputType>
    <RootNamespace>Kapso.Tests</RootNamespace>
    <!-- xUnit v3 ships its own console runner by default. The repo runs tests
         through Microsoft.Testing.Platform (see the test.runner entry in
         global.json), which the .NET 10 SDK requires, so opt into it here. -->
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <!-- Test code is not shipped, so it is not held to the AOT contract. -->
    <IsAotCompatible>false</IsAotCompatible>
    <IsTrimmable>false</IsTrimmable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Kapso/Kapso.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.Testing" />
  </ItemGroup>

</Project>
