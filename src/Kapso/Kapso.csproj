<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Kapso.Client.Net</PackageId>
    <Description>Typed .NET client for the Kapso APIs (WhatsApp, Platform, Workflows and Agent), generated from Kapso's official OpenAPI descriptions with Kiota.</Description>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Usable from Native AOT and trimmed apps. Verified by the AOT publish of
       samples/Kapso.Samples.Aot in CI, not just by these switches. -->
  <PropertyGroup>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <!-- Source-generates the configuration binder so AddKapso(IConfiguration)
         works under trimming and AOT, where reflection-based binding does not. -->
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
  </PropertyGroup>

  <!-- Downloads the baseline from nuget.org and fails the build on an API break
       against it. Without this, an added optional parameter looks harmless — it
       is source compatible — while silently removing the old signature and
       breaking anyone already compiled against it. -->
  <PropertyGroup>
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>0.1.0</PackageValidationBaselineVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Kiota.Bundle" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../../README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Kapso.Tests" />
  </ItemGroup>

</Project>
