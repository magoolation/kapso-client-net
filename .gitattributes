# Normalize line endings in the repository. Without this, the CI check that
# regeneration reproduces what is committed would fail whenever the generating
# machine's line endings differ from the committing machine's.
* text=auto

*.cs      text diff=csharp
*.csproj  text
*.props   text
*.targets text
*.slnx    text
*.json    text
*.yaml    text
*.yml     text
*.md      text
*.ps1     text eol=lf
*.sh      text eol=lf

# Anything whose bytes must survive a checkout unchanged. Git's own heuristic is
# not enough: a PDF is mostly ASCII, so it was classified as text, and a Windows
# checkout would have rewritten its line endings — shifting every byte offset in
# the cross-reference table and producing a file no reader accepts.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.ogg binary
*.mp3 binary
*.mp4 binary
*.wav binary
*.zip binary
*.snk binary
*.pfx binary
